{
  "name": "solarfarms-cy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "market:download": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/download-market-data.ts",
    "market:parse": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/download-market-data.ts --parse-only",
    "market:saturation": "npx tsx scripts/analyze-bess-market-saturation.ts",
    "market:fetch": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/fetch-tsoc-playwright.ts",
    "market:fetch-backfill": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/fetch-tsoc-playwright.ts --backfill",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:validate": "tsx scripts/validate-docs.ts",
    "docs:update": "tsx scripts/generate-docs.ts && tsx scripts/validate-docs.ts",
    "investor-model:agios": "npx tsx scripts/generate-agios-theodoros-investor-xlsx.ts",
    "teaser:agios": "npx tsx scripts/generate-agios-teaser-html.ts",
    "pack:agios": "npx tsx scripts/generate-agios-teaser-html.ts && npx tsx scripts/generate-agios-theodoros-investor-xlsx.ts",
    "teaser:cyprus": "npx tsx scripts/generate-cyprus-market-teaser-html.ts",
    "rtb:segments": "npx tsx scripts/import-cera-prospects.ts --dry-run --min-mwp 1",
    "rtb:report": "npx tsx scripts/generate-rtb-intelligence-report.ts",
    "cyprus:plants": "npx tsx scripts/import-cera-plants.ts --json-only --min-mwp 0.1",
    "cyprus:eac-parse": "python scripts/research/parse-eac-res-pdf.py --all",
    "cyprus:match": "npx tsx scripts/match-cyprus-plants.ts --dry-run",
    "cyprus:pipeline": "npx tsx scripts/import-cera-plants.ts --json-only --min-mwp 0.1 && python scripts/research/parse-eac-res-pdf.py --all && npx tsx scripts/match-cyprus-plants.ts --dry-run && npx tsx scripts/generate-cyprus-rtb-segments.ts && npx tsx scripts/import-cera-prospects.ts --dry-run --min-mwp 1",
    "cyprus:intelligence": "npm run cyprus:pipeline && npm run rtb:report",
    "enrich:register": "npx tsx scripts/enrich-prospects.ts --stage 1 --limit 50",
    "enrich:contacts": "npx tsx scripts/enrich-prospects.ts --stage 3 --limit 50",
    "cyprus:register": "npx tsx scripts/enrich-cyprus-plants-register.ts --limit 50 --min-score 35",
    "cyprus:contacts": "npx tsx scripts/enrich-cyprus-plants-contacts.ts --limit 80 --min-score 35",
    "cyprus:directors": "npx tsx scripts/analyze-cyprus-directors.ts --min-spvs 2",
    "cyprus:cluster": "npx tsx scripts/cluster-cyprus-developers.ts --min-score 35",
    "cyprus:developer-domains": "npx tsx scripts/resolve-cyprus-developer-domains.ts --min-spvs 2",
    "cyprus:hunter": "npx tsx scripts/enrich-cyprus-developers-hunter.ts --min-spvs 2",
    "cyprus:clean-contacts": "npx tsx scripts/clean-cyprus-contacts.ts",
    "cyprus:sync-crm": "npx tsx scripts/sync-cyprus-to-crm.ts --min-score 35",
    "cyprus:sync-commercial": "npx tsx scripts/sync-solar-sweep-to-crm.ts --min-roof 200",
    "commercial:sweep": "npx tsx scripts/run-commercial-sweep.ts",
    "commercial:hunter": "npx tsx scripts/enrich-commercial-sweep-hunter.ts --limit 80",
    "commercial:sync-crm": "npx tsx scripts/sync-solar-sweep-to-crm.ts --min-roof 200",
    "commercial:pipeline": "npm run commercial:sweep && npm run commercial:hunter && npm run commercial:sync-crm",
    "commercial:enrich-email": "npx tsx scripts/enrich-commercial-crm-hunter.ts --limit 50",
    "commercial:enrich-register": "npx tsx scripts/enrich-commercial-crm-register.ts --limit 30",
    "crm:backfill-aliases": "npx tsx scripts/backfill-search-aliases.ts",
    "crm:sync-off-registry": "npx tsx scripts/sync-off-registry-to-crm.ts",
    "cyprus:dev-pipeline": "npm run cyprus:cluster && npm run cyprus:developer-domains && npm run cyprus:hunter && npm run cyprus:clean-contacts && npm run cyprus:cluster && npm run cyprus:sales-export && npm run cyprus:sales-html",
    "cyprus:full": "npm run cyprus:dev-pipeline && npm run cyprus:sync-crm && npm run crm:sync-off-registry",
    "cyprus:sales-export": "npx tsx scripts/export-cyprus-sales-targets.ts --min-score 35",
    "cyprus:sales-html": "npx tsx scripts/generate-cyprus-sales-targets-html.ts --min-score 35",
    "cyprus:sales-report": "npm run cyprus:contacts -- --limit 80 --min-score 35 --force && npm run cyprus:directors && npm run cyprus:sales-export && npm run cyprus:sales-html",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "solhash:roi": "npx tsx solhash/scripts/run-roi-comparison.ts",
    "solhash:presentation": "npx tsx solhash/scripts/generate-presentation.ts",
    "sanity": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "wp:info": "npx tsx scripts/wp-lighthief-sync.ts info",
    "wp:list": "npx tsx scripts/wp-lighthief-sync.ts list-pages",
    "wp:posts": "npx tsx scripts/wp-lighthief-sync.ts list-posts",
    "wp:push": "npx tsx scripts/wp-lighthief-sync.ts push-page",
    "wp:push-all": "npx tsx scripts/wp-lighthief-sync.ts push-all",
    "wp:media": "npx tsx scripts/wp-lighthief-sync.ts upload-media",
    "wp:new-post": "npx tsx scripts/wp-lighthief-sync.ts new-post"
  },
  "dependencies": {
    "@auth/supabase-adapter": "^1.11.1",
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/client": "^6.8.0",
    "@sanity/icons": "^2.11.8",
    "@sanity/image-url": "^1.0.2",
    "@sanity/vision": "^3.19.0",
    "@supabase/supabase-js": "^2.38.0",
    "@vercel/analytics": "^1.1.0",
    "@vercel/og": "^0.6.2",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "framer-motion": "^10.16.4",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "next-sanity": "^7.1.4",
    "next-seo": "^6.4.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.2.1",
    "openai": "^6.25.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.31",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-intersection-observer": "^9.5.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.4",
    "resend": "^6.1.0",
    "sanity": "^3.19.0",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.8.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "cssnano": "^7.1.1",
    "eslint": "^8.51.0",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.58.2",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.6",
    "typescript": "^5.2.2"
  }
}
