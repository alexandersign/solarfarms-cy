# ─────────────────────────────────────────────────────────────
# lighthief.cy WordPress credentials
# Copy this file to .env.lighthief.local and fill in values.
# .env.lighthief.local is gitignored — NEVER commit credentials.
# ─────────────────────────────────────────────────────────────

# WordPress site URL (no trailing slash)
WP_LH_URL=https://lighthief.cy

# Your WordPress admin username
WP_LH_USER=your-wp-username

# Application Password — generate at:
# WP Admin → Users → Profile → Application Passwords
# Format: xxxx xxxx xxxx xxxx xxxx xxxx  (spaces are fine)
WP_LH_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: default page author ID (find at WP Admin → Users)
WP_LH_AUTHOR_ID=1
